{
  "name": "vikranth-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:links": "linkinator ./dist",
    "check:lh": "lhci autorun",
    "sync:fonts": "cp node_modules/@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2 public/fonts/inter-latin-var.woff2 && cp node_modules/@fontsource-variable/inter/LICENSE public/fonts/LICENSE.txt",
    "verify": "npm run check && npm run test && npm run build && npm run check:links && npm run check:lh"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "linkinator": "^7.6.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
