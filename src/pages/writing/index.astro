---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShell from '../../components/PageShell.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/content';

const posts = await getPublishedPosts();
---
<BaseLayout
  title="Writing · Vikranth Subramanian"
  description="Working notes and open questions on systems, networks, infrastructure, and product."
>
  <PageShell>
    <PageHeader title="Writing">
      <p class="lede">
        Working notes, half-formed arguments, and things I'm still figuring out. I write
        to think, not to conclude, so expect open questions more often than answers.
      </p>
    </PageHeader>

    {posts.length === 0
      ? <p class="empty">Nothing published yet.</p>
      : posts.map((post) => <PostCard post={post} headingLevel={2} />)}
  </PageShell>
</BaseLayout>

<style>
  .empty { color: var(--color-text-dim); }
</style>
