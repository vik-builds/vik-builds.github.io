---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
import PageHeader from '../components/PageHeader.astro';
---
<BaseLayout title="Not found · Vikranth Subramanian" description="That page doesn't exist.">
  <PageShell align="center" pad="roomy">
    <PageHeader title="That page doesn't exist." align="center">
      <span slot="eyebrow" class="code">404</span>
      <p class="lede">The link may be out of date, or the page may have moved.</p>
    </PageHeader>

    <ul class="links">
      <li><a href="/">Home</a></li>
      <li><a href="/work/">Work</a></li>
      <li><a href="/writing/">Writing</a></li>
      <li><a href="/about/">About</a></li>
    </ul>
  </PageShell>
</BaseLayout>

<style>
  .code { font-family: var(--font-mono); color: var(--color-accent); }
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }
</style>
