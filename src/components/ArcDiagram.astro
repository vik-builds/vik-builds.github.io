---
/**
 * A visual summary of the career arc. Six ascending columns, each labelled with
 * the movement and the system it operated on, so the climb is something the
 * reader sees before they read the argument for it.
 *
 * Presentational only. The prose below it carries the real content, so the whole
 * diagram is hidden from assistive technology and the same information is
 * available as text in each movement heading.
 */

const MOVEMENTS = [
  { n: 1, title: 'Signals', system: 'Radar returns', years: '2013' },
  { n: 2, title: 'Networks', system: 'Enterprise hosts', years: '2018' },
  { n: 3, title: 'Infrastructure', system: 'Cloud estates', years: '2018' },
  { n: 4, title: 'Zero to one', system: 'The company', years: '2020' },
  { n: 5, title: 'Platforms', system: 'Production systems', years: '2022' },
  { n: 6, title: 'Products', system: 'What gets built', years: '2024' },
];
---
<figure class="arc">
  <figcaption class="caption">
    <span class="axis-label">Altitude</span>
    <span class="axis-note">The same question, asked one layer up each time</span>
  </figcaption>

  <div class="chart" aria-hidden="true">
    {MOVEMENTS.map((m) => (
      <div class="col" style={`--step: ${m.n}`}>
        <p class="system">{m.system}</p>
        <div class="bar"><span class="fill"></span><span class="dot"></span></div>
        <p class="title">{m.title}</p>
        <p class="years">{m.years}</p>
      </div>
    ))}
  </div>
</figure>

<style>
  .arc {
    margin: 0 0 var(--space-16);
    padding: var(--space-6) 0 0;
    border-top: 1px solid var(--color-border);
  }

  .caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  .axis-label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent-quiet);
  }
  .axis-note { font-size: var(--text-sm); color: var(--color-text-dim); }

  .chart {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-3);
    align-items: end;
  }

  .col { display: flex; flex-direction: column; min-width: 0; }

  /* Each column's bar is taller than the last, so the six of them read as a climb.
     Height is driven by --step (1 to 6) rather than six hand-written values. */
  .bar {
    position: relative;
    height: calc(28px + (var(--step) * 26px));
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-accent) 6%, transparent),
      color-mix(in srgb, var(--color-accent) 20%, transparent)
    );
    border: 1px solid var(--color-border);
    border-bottom: none;
    margin-top: var(--space-3);
  }
  .fill {
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: var(--gradient-accent);
    opacity: calc(0.35 + (var(--step) * 0.11));
  }
  /* The node sits on top of each bar, tracing the ascending line. */
  .dot {
    position: absolute;
    top: -4px;
    left: 50%;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 1.5px solid var(--color-accent);
  }

  .system {
    font-size: var(--text-xs);
    color: var(--color-text-dim);
    line-height: 1.35;
    min-height: 2.7em;
  }
  .title {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.25;
  }
  .years {
    font-size: var(--text-xs);
    color: var(--color-text-dim);
    font-family: var(--font-mono);
    margin-top: var(--space-1);
  }

  /* Below the breakpoint six columns become unreadably narrow, so the chart
     rotates into a vertical list whose bars grow in width instead of height. */
  @media (max-width: 820px) {
    .chart { grid-template-columns: 1fr; gap: var(--space-4); }
    .col {
      display: grid;
      grid-template-columns: 5.5rem 1fr;
      grid-template-areas:
        'title bar'
        'system bar';
      align-items: center;
      gap: 0 var(--space-4);
    }
    .title { grid-area: title; margin: 0; }
    .system { grid-area: system; min-height: 0; }
    .years { display: none; }
    .bar {
      grid-area: bar;
      height: 10px;
      margin: 0;
      width: calc(24% + (var(--step) * 12.5%));
      border-radius: 0 var(--radius-pill) var(--radius-pill) 0;
      border: 1px solid var(--color-border);
      border-left: none;
      background: linear-gradient(
        to right,
        color-mix(in srgb, var(--color-accent) 8%, transparent),
        color-mix(in srgb, var(--color-accent) 26%, transparent)
      );
    }
    .fill { inset: 0 0 auto 0; height: 100%; background: none; }
    .dot { top: 50%; left: auto; right: -4px; margin: -3.5px 0 0 0; }
  }
</style>
