---
import { getCollection, render } from 'astro:content';
import { formatDate, isoDate } from '../lib/format';

const entries = await getCollection('now');
const current = entries[0];
const rendered = current ? await render(current) : null;
---
{current && rendered && (
  <section class="now" aria-labelledby="now-heading">
    <header>
      <h2 id="now-heading">Now</h2>
      <time datetime={isoDate(current.data.updated)}>
        Updated {formatDate(current.data.updated)}
      </time>
    </header>
    <div class="body">
      <rendered.Content />
    </div>
  </section>
)}

<style>
  .now {
    max-width: var(--width-content);
    margin: var(--space-16) auto 0;
    padding: 0 var(--space-6);
  }
  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }
  h2 { font-size: var(--text-xl); }
  time {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-dim);
  }
  .body {
    max-width: var(--width-prose);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }
  .body :global(p + p) { margin-top: var(--space-4); }

  @media (max-width: 640px) {
    .now { margin-top: var(--space-12); padding: 0 var(--space-4); }
    header { flex-wrap: wrap; gap: var(--space-1) var(--space-4); }
    .body { font-size: var(--text-base); }
  }
</style>
