---
import { SITE } from '../lib/site';
const year = new Date().getFullYear();
---
<footer>
  <div class="inner">
    <p class="left">{SITE.location}</p>
    <ul class="links">
      <li><a href={`mailto:${SITE.email}`}>Email</a></li>
      <li><a href={SITE.social.github} rel="me noopener">GitHub</a></li>
      <li><a href={SITE.social.linkedin} rel="me noopener">LinkedIn</a></li>
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
    <p class="right">© {year} {SITE.author}</p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-24);
  }
  .inner {
    max-width: var(--width-content);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-sm);
    color: var(--color-text-dim);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  p { margin: 0; }

  @media (max-width: 640px) {
    footer { margin-top: var(--space-16); }
    .inner {
      padding: var(--space-6) var(--space-4);
      gap: var(--space-4);
      justify-content: flex-start;
    }
    /* One column at phone widths: three flex items on one row is what pushed
       the footer past the viewport. */
    .inner > * { flex: 1 0 100%; }
    .links { gap: var(--space-2) var(--space-4); }
    li a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
