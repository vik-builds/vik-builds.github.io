---
import { Image } from 'astro:assets';
import NetworkGraph from './NetworkGraph.astro';
import portrait from '../assets/portrait.jpg';
import { SITE } from '../lib/site';

const credentials = [
  SITE.location,
  'MEng Telecommunications, UNSW',
  '3 publications',
  '8 certifications',
];
---
<section class="hero">
  <div class="glow glow-1" aria-hidden="true"></div>
  <div class="glow glow-2" aria-hidden="true"></div>
  <NetworkGraph />

  <div class="content">
    <div class="intro">
      <Image
        class="portrait"
        src={portrait}
        alt="Vikranth Subramanian"
        width={132}
        height={132}
        loading="eager"
        fetchpriority="high"
      />
      <div class="intro-text">
        <p class="pill"><span class="dot" aria-hidden="true"></span>Currently building &amp; writing</p>
        <p class="greeting">Hi, I'm Vikranth.</p>
      </div>
    </div>

    <h1>Engineer, product builder, <span class="gradient-text">persistent tinkerer</span>.</h1>
    <p class="lede">
      I'm interested in how complex systems actually behave: networks, platforms,
      teams, models. This is where I keep the things I've built and the things I'm
      still working out.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="/work/">See the work</a>
      <a class="btn btn-secondary" href="/writing/">Read the writing</a>
    </div>
  </div>

  <ul class="credentials">
    {credentials.map((c) => <li>{c}</li>)}
  </ul>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }
  .glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .glow-1 {
    width: 560px; height: 560px; right: -150px; top: -220px;
    background: radial-gradient(circle, var(--color-accent-glow), transparent 65%);
  }
  .glow-2 {
    width: 430px; height: 430px; left: -140px; bottom: -200px;
    background: radial-gradient(circle, var(--color-accent-2-glow), transparent 65%);
  }
  .content {
    position: relative;
    max-width: var(--width-wide);
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-12);
  }
  .intro {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  /* The ring ties the warm photo to the site's accent so it reads as part of the
     design rather than dropped on top of it. */
  .portrait {
    width: 132px;
    height: 132px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--color-border-strong);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent) 12%, transparent);
  }
  .intro-text { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  .greeting {
    font-size: var(--text-md);
    color: var(--color-text);
    font-weight: 500;
    letter-spacing: var(--tracking-snug);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface-translucent);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 8px var(--color-success);
  }
  h1 {
    font-size: var(--text-4xl);
    max-width: min(20ch, 100%);
    margin-bottom: var(--space-4);
  }
  .lede {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: min(60ch, 100%);
  }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--space-3) var(--space-6);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }
  .btn-primary { background: var(--color-text); color: var(--color-bg); }
  .btn-primary:hover,
  .btn-primary:focus-visible { background: var(--color-accent-quiet); color: var(--color-bg); }

  /* WCAG 1.4.11: this border is the button's ONLY boundary affordance, so it
     has to clear 3:1 against the canvas. --color-border-strong composited to
     1.52:1 and failed; --color-border-interactive composites over --color-bg to
     3.24:1 and passes. */
  .btn-secondary {
    border-color: var(--color-border-interactive);
    color: var(--color-text);
  }
  .btn-secondary:hover,
  .btn-secondary:focus-visible {
    border-color: var(--color-accent-quiet);
    background: var(--color-surface-translucent);
    color: var(--color-text);
  }
  .credentials {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: var(--space-4) var(--space-6);
    max-width: var(--width-wide);
    margin-inline: auto;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  /* ---- Narrow viewports ----
     Gutters drop from --space-6 to --space-4, the credential row loses its
     wide inter-item gap, and the h1 comes down off the --text-4xl floor so
     "persistent" cannot force a horizontal scroll at 320px. */
  @media (max-width: 640px) {
    .content { padding: var(--space-12) var(--space-4) var(--space-8); }
    .intro { gap: var(--space-4); margin-bottom: var(--space-4); }
    .portrait { width: 84px; height: 84px; }
    .greeting { font-size: var(--text-base); }
    h1 { font-size: var(--text-2xl); max-width: none; }
    .lede { font-size: var(--text-base); }
    .credentials {
      gap: var(--space-2) var(--space-4);
      padding: var(--space-4);
    }
    .actions { gap: var(--space-2); }
    .btn { flex: 1 1 auto; padding-inline: var(--space-4); }
  }
</style>
