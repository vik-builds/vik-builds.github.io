---
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate } from '../lib/format';

interface Props {
  post: CollectionEntry<'posts'>;
  /** Heading level for the card title. Must sit one level below the nearest
   *  preceding heading or the page fails the heading-order audit: the homepage
   *  nests these under an <h2>, while /writing/ lists them directly under <h1>. */
  headingLevel?: 2 | 3;
}
const { post, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---
<article class="card">
  <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
  <Heading class="title"><a href={`/writing/${post.id}/`}>{post.data.title}</a></Heading>
  <p>{post.data.description}</p>
  {post.data.tags.length > 0 && (
    <ul class="tags">
      {post.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}
</article>

<style>
  /* The card bleeds --space-3 (12px) past its text column so the hover surface
     reads as a row rather than a floating box. Every page that renders this list
     has a --space-6 (24px) gutter and narrows only to --space-4 (16px), so a
     12px bleed can never reach the viewport edge and cause horizontal overflow. */
  .card {
    padding: var(--space-6) var(--space-3);
    margin-inline: calc(var(--space-3) * -1);
    border-bottom: 1px solid var(--color-border);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    transition:
      border-color var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }
  /* Hover and focus-within resolve to the same treatment on purpose, because
     the keyboard path must not be the degraded one. */
  .card:hover,
  .card:focus-within {
    background: var(--color-surface);
    border-bottom-color: var(--color-border-interactive);
    transform: translateY(-2px);
  }
  time {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-dim);
  }
  /* Card titles are --text-md across PostCard, ProjectCard and ResearchEntry:
     one rung below section headings (--text-xl) and one above body (--text-lg),
     per the token scale. Previously --text-xl here, which made a post card title
     the same size as the section heading above it. */
  .title { font-size: var(--text-md); margin: var(--space-2) 0; overflow-wrap: break-word; }
  .title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }
  .card:hover .title a,
  .title a:hover,
  .title a:focus-visible { color: var(--color-accent-quiet); }
  p { color: var(--color-text-muted); max-width: var(--width-prose); }
  .tags {
    display: flex; flex-wrap: wrap; gap: var(--space-2);
    list-style: none; margin: var(--space-3) 0 0; padding: 0;
  }
  .tags li {
    font-size: var(--text-xs);
    color: var(--color-text-dim);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: var(--space-1) var(--space-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover,
    .card:focus-within { transform: none; }
  }

  @media (max-width: 640px) {
    .card { padding: var(--space-4) var(--space-3); }
  }
</style>
